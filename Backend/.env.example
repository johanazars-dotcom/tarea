# Copia este archivo como .env y completa los valores.
# No subas .env al repositorio.

SECRET_KEY=genera_una_clave_secreta
DEBUG=True

DB_NAME=medicamentos
DB_USER=postgres
DB_PASSWORD=tu_clave_de_postgres
DB_HOST=localhost
DB_PORT=5432

# Opcionales para crear el superusuario automaticamente en Render (build.sh)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
